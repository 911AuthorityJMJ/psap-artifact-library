# Copy to .env.local (dev) or set in your deployment environment.

# Shared HS256 signing key for the ASP.NET → Next.js authentication bridge.
# The ASP.NET SurveyTool site signs a short-lived JWT with this key and drops it
# in the HttpOnly `psap_session` cookie; this app verifies it (src/lib/auth.ts).
#   - MUST be the SAME value configured for the ASP.NET IIS app.
#   - Base64-encoded, at least 32 random bytes. Generate, e.g.:
#       openssl rand -base64 48
#     or PowerShell:
#       $b = New-Object byte[] 48;
#       [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b);
#       [Convert]::ToBase64String($b)
#   - REQUIRED in production: if unset/invalid in production the API fails closed
#     (503), so a deployed instance is never accidentally open.
#   - Optional in local dev: if unset, auth is bypassed locally for convenience.
PSAP_BRIDGE_SECRET=

# Expected JWT issuer / audience. Defaults (used if unset) are shown; only set
# these if the ASP.NET side is configured with different values.
#PSAP_TOKEN_ISS=in911-ngsec.911authority.com
#PSAP_TOKEN_AUD=psap-artifact-library
